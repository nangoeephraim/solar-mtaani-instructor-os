{
    "buildCommand": "node --max-old-space-size=3072 node_modules/vite/bin/vite.js build",
    "outputDirectory": "dist",
    "functions": {
        "api/**/*.ts": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}